# Copy to .env (already git-ignored) before running `docker compose up`.
# Never commit the real values -- see docs/task-logs/T15.md.

# Must match the plaintext content of the secret file referenced by
# `waha_token_file` in settings.toml (T02/config.py). WAHA requires this on
# every request to its own REST API via the X-Api-Key header.
WAHA_API_KEY=replace-with-the-same-value-as-waha_token_file

# Protects WAHA's own /dashboard UI. Defense-in-depth only -- the port is
# bound to 127.0.0.1, never a public port (docs/task-logs/T15.md).
WAHA_DASHBOARD_USERNAME=replace-me
WAHA_DASHBOARD_PASSWORD=replace-with-a-strong-password

# Protects WAHA's own Swagger UI at /.
WHATSAPP_SWAGGER_USERNAME=replace-me
WHATSAPP_SWAGGER_PASSWORD=replace-with-a-strong-password
